      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
    'V-':
      PIN_NUMBER='(4)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
    'EP':
      PIN_NUMBER='(9)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
    'V+':
      PIN_NUMBER='(8)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
    'OUT_B':
      PIN_NUMBER='(7)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
    '-IN_B':
