      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
  END_PIN;
  BODY
    PART_NAME='OPA1612AIDRGR';
    PHYS_DES_PREFIX='IC';
    NO_LOAD_CHECK='TRUE';
    PIN_COUNT='9';
    BODY_NAME='OPA1612AIDRGR';
    JEDEC_TYPE='SON50P300X300X80-9N-D';
  END_BODY;
END_PRIMITIVE;
END.
